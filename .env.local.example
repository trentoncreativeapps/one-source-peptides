# Copy to .env.local for local work, and paste the same values into
# Vercel -> Project -> Settings -> Environment Variables for deploys.
#
# Supabase dashboard -> Project Settings -> API
#   Project URL      -> NEXT_PUBLIC_SUPABASE_URL
#   anon public key  -> NEXT_PUBLIC_SUPABASE_ANON_KEY
#   service_role key -> SUPABASE_SERVICE_ROLE_KEY

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses every RLS policy in the database.
# Never prefix this with NEXT_PUBLIC_, never import it into a client component.
SUPABASE_SERVICE_ROLE_KEY=

# Transactional email (already in use on the static site)
RESEND_API_KEY=
NOTIFY_EMAIL=
FROM_EMAIL=


# ---------------------------------------------------------------------------
# Card processing — NMI / transactiongateway protocol
#
# Both processors under consideration resell the same gateway platform, so the
# integration is identical and the choice is commercial, not technical:
#   Seamless Chex -> white-labels NMI at seamlesschex.transactiongateway.com
#                    (their Paynote ACH product is a separate API, not this one)
#   AllayPay      -> resells NMI directly, and underwrites peptide merchants
#
# Switching processors = change PAYMENT_GATEWAY_URL and the keys. No code change.
# Keys come from the GATEWAY portal (Settings -> Security Keys), which is a
# different login from the processor's own dashboard.
# ---------------------------------------------------------------------------

# Full transaction endpoint, including /api/transact.php.
# Seamless Chex: https://seamlesschex.transactiongateway.com/api/transact.php
# AllayPay/NMI:  https://secure.networkmerchants.com/api/transact.php
#                (confirm the exact host on your account)
PAYMENT_GATEWAY_URL=

# SERVER ONLY — the gateway's `security_key`. It can charge cards.
# Treat it exactly like the service_role key: never NEXT_PUBLIC_, never
# committed, never pasted into chat, a ticket, or a screenshot.
PAYMENT_GATEWAY_SECURITY_KEY=

# PUBLIC by design. Collect.js uses this in the browser to tokenise card
# details so no card number ever reaches our servers. Safe to expose.
NEXT_PUBLIC_PAYMENT_TOKENIZATION_KEY=

# SERVER ONLY. Signing secret for gateway webhooks (renewals, settlements,
# chargebacks). Without it the webhook route rejects everything, by design.
PAYMENT_GATEWAY_WEBHOOK_SECRET=
